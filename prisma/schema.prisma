// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/**
 * ============================
 * ROLE
 * ============================
 */
model Role {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users User[]
}

/**
 * ============================
 * USER
 * ============================
 */
model User {
  id     String @id @default(uuid())
  roleId String
  role   Role   @relation(fields: [roleId], references: [id])

  username     String?  @unique
  firstName    String?
  lastName     String?
  uniEmail     String?  @unique
  gender       String?
  avatarUrl    String?
  phoneNum     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  admin   Admin?
  superAdmin SuperAdmin?
  student Student?
}

/**
 * ============================
 * ADMIN
 * ============================
 */
model Admin {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  adminLevel Int

  buildingId String?
  building   Building? @relation(fields: [buildingId], references: [id])

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookings  Booking[]
  approvals Approval[]
}

/**
 * ============================
 * SUPER_ADMIN
 * ============================
 */
model SuperAdmin {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/**
 * ============================
 * STUDENT
 * ============================
 */
model Student {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  iitIdNumber     String  @unique
  societyName     String?
  societyPosition String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  requests Request[]
}

/**
 * ============================
 * STATUS
 * ============================
 */
model Status {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  requests  Request[]
  approvals Approval[]
}

/**
 * ============================
 * DEPARTMENT
 * ============================
 */
model Department {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  resources Resource[]
  admins    Admin[]
}

/**
 * ============================
 * BUILDING
 * ============================
 */
model Building {
  id          String  @id @default(uuid())
  name        String  @unique
  address     String?
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  venues Venue[]
  admins Admin[]
}

/**
 * ============================
 * TIME_SLOT
 * ============================
 */
model TimeSlot {
  id        String   @id @default(uuid())
  name      String
  startTime DateTime
  endTime   DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  requestSlots RequestTimeSlot[]
}

/**
 * ============================
 * ATTACHMENT
 * ============================
 */
model Attachment {
  id        String  @id @default(uuid())
  requestId String
  fileName  String?
  realName  String?
  fileSize  String?
  mimeType  String?

  request Request @relation(fields: [requestId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/**
 * ============================
 * REQUEST
 * ============================
 */
model Request {
  id        String @id @default(uuid())
  studentId String
  venueId   String
  statusId  String

  student Student @relation(fields: [studentId], references: [id])
  venue   Venue   @relation(fields: [venueId], references: [id])
  status  Status  @relation(fields: [statusId], references: [id])

  formData     Json?
  title        String?
  description  String?
  attendance   Int?
  requiredDate DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookings     Booking[]
  logs         Log[]
  requestSlots RequestTimeSlot[]
  attachments  Attachment[]
  approvals    Approval[]
}

/**
 * ============================
 * BOOKING
 * ============================
 */
model Booking {
  id        String @id @default(uuid())
  requestId String
  adminId   String

  request Request @relation(fields: [requestId], references: [id])
  admin   Admin   @relation(fields: [adminId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  logs Log[]
}

/**
 * ============================
 * LOG
 * ============================
 */
model Log {
  id          String  @id @default(uuid())
  bookingId   String?
  requestId   String?
  description String?

  booking Booking? @relation(fields: [bookingId], references: [id])
  request Request? @relation(fields: [requestId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/**
 * ============================
 * RESOURCES
 * ============================
 */
model Resource {
  id String @id @default(uuid())

  name        String
  isAvailable Boolean? @default(true)

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // venueResources VenueResource[]
}

/**
 * ============================
 * VENUE
 * ============================
 */
model Venue {
  id String @id @default(uuid())

  name                String
  description         String?
  isAvailable         Boolean? @default(true)
  capacityAcademic    String?
  capacityExamination String?
  floorNumber         String?

  buildingId String?
  building   Building? @relation(fields: [buildingId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  requests Request[]
  // venueResources VenueResource[]
}

/**
 * ============================
 * APPROVAL
 * ============================
 */
model Approval {
  id String @id @default(uuid())

  requestId String
  request   Request @relation(fields: [requestId], references: [id])

  adminId String
  admin   Admin  @relation(fields: [adminId], references: [id])

  adminLevel Int
  statusId   String
  comment    String?

  status Status @relation(fields: [statusId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([requestId, adminLevel])
}

